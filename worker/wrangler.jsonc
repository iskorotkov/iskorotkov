{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iskorotkov-cv-links",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "iskorotkov.com/cv*", "zone_name": "iskorotkov.com" },
    { "pattern": "iskorotkov.com/Senior*", "zone_name": "iskorotkov.com" }
  ]
}
